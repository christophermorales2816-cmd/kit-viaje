# Supabase — proyecto del corredor Argentina/Buenos Aires.
# Copiar a .env.local y completar con los valores del proyecto.

# Públicas: expuestas al browser. Sirven para las lecturas con RLS
# de solo lectura pública (spec, sección 3).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: NUNCA con prefijo NEXT_PUBLIC_. La usan las Server Actions,
# que son el único camino de escritura y validan edit_token antes de
# tocar la base (spec, sección 3).
SUPABASE_SERVICE_ROLE_KEY=
